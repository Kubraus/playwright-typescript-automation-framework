{
  "name": "playwright-typescript-automation-framework",
  "version": "1.0.0",
  "description": "Portfolio test automation framework built with Playwright and TypeScript.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:regression": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test tests/api --workers=4",
    "test:stable": "playwright test --workers=1",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run format && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3"
  },
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.15.0"
  }
}
